# ── Anthropic (Claude AI) ──────────────────────────────────────────────────────
# Required: used to score and rank all items for relevance to your company
ANTHROPIC_API_KEY=sk-ant-...

# ── Email delivery — choose ONE of the two options below ──────────────────────

# Option A: SMTP (recommended — no API key, works with Gmail or Outlook)
#   Gmail setup:
#     1. Enable 2-Step Verification on your Google account
#     2. Go to myaccount.google.com → Security → App Passwords
#     3. Generate a password for "Mail" → paste the 16 chars below
#   Outlook/Office 365: use smtp.office365.com port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Option B: SendGrid (only needed if you prefer SendGrid over SMTP)
# SENDGRID_API_KEY=SG....
# DIGEST_FROM_EMAIL=digest@yourcompany.com   ← must be a verified SendGrid sender

# ── Recipients ─────────────────────────────────────────────────────────────────
DIGEST_FROM_NAME=Defense BD Digest
DIGEST_TO_EMAILS=you@yourcompany.com,colleague@yourcompany.com

# ── SAM.gov (optional) ─────────────────────────────────────────────────────────
# Adds live solicitation/RFP opportunities on top of the USASpending.gov award
# intelligence that runs automatically with no key.
# Free key: https://sam.gov/profile/details  (account + email verification required)
# SAM_GOV_API_KEY=

# ── Scoring thresholds (optional) ─────────────────────────────────────────────
MIN_NEWS_SCORE=75
MIN_OPPORTUNITY_SCORE=75
LOOKBACK_DAYS=1
