# ── Anthropic (Claude AI) ──────────────────────────────────────────────────────
# Required: used to score and rank all news items and opportunities
ANTHROPIC_API_KEY=sk-ant-...

# ── SendGrid ───────────────────────────────────────────────────────────────────
# Required: used to send the weekly digest email
SENDGRID_API_KEY=SG....
DIGEST_FROM_EMAIL=digest@yourcompany.com
DIGEST_FROM_NAME=Defense BD Digest

# Comma-separated list of recipient email addresses
DIGEST_TO_EMAILS=bd@yourcompany.com,ceo@yourcompany.com

# ── SAM.gov ────────────────────────────────────────────────────────────────────
# Optional but strongly recommended: get a free key at https://sam.gov/profile/details
# Without this, only RSS news feeds will be included (no contract opportunities)
SAM_GOV_API_KEY=

# ── Behavior ───────────────────────────────────────────────────────────────────
# Minimum relevance score (0-100) to include an item in the digest
# Raise to tighten the filter; lower to get more items
MIN_NEWS_SCORE=45
MIN_OPPORTUNITY_SCORE=55

# How many days back to look for news/opportunities (default: 7 for weekly)
LOOKBACK_DAYS=7
